<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit</title>
</head>
<body>
    <h2>Edit User Name of User: <i><%= user.email %></i></h2>
    <form method="post" action="/users/<%= user.id %>?_method=PATCH">
        <textarea name="username"> <%= user.username %> </textarea>
        <br>
        <input type="password" name="password" placeholder="Enter your password">
        <br>
        <button>Edit</button>
    </form>
</body>
</html>